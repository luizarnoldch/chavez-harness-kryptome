---
import "../styles/global.css";
import { env } from "../lib/config";
import { NavAuth } from "../components/NavAuth";

interface Props {
  title?: string;
}

const { title = "Chavez" } = Astro.props;
const docsUrl = `${env.public.apiUrl.replace(/\/$/, "")}/docs`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} · Chavez</title>
  </head>
  <body>
    <div class="shell">
      <nav class="nav">
        <a class="brand" href="/">Chavez</a>
        <a href="/">Hub</a>
        <NavAuth client:load />
        <a href="/device">Device</a>
        <a href="/providers">Providers</a>
        <a href="/skills">Skills</a>
        <a href="/memory">Memoria</a>
        <a href="/prompts">Prompts</a>
        <a href="/workspaces">Workspaces</a>
        <a href="/chats/search">Buscar</a>
        <a href={docsUrl} rel="noreferrer">API docs</a>
      </nav>
      <slot />
    </div>
  </body>
</html>
