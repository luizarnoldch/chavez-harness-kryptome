# =============================================================================
# Stack ports (fixed map)
#   postgres 25000 | api 25001 | web 25002 | next 25003…
# =============================================================================

# =============================================================================
# API — private (server-only; validated in api/src/lib/config.ts)
# =============================================================================
DATABASE_URL=postgresql://chavez:chavez@localhost:25000/chavez
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
PROVIDER_SECRETS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
RESEND_API_KEY=
RESEND_FROM=Chavez <onboarding@resend.dev>
# Optional override. Must match BETTER_AUTH_URL / PUBLIC_CHAVEZ_API_URL / CHAVEZ_API_URL.
# If unset, API binds 25001 and fails if busy (no silent jump to 26001).
# PORT=25001
# NODE_ENV=development
WEB_ORIGIN=http://localhost:25002

# =============================================================================
# API — public
# =============================================================================
BETTER_AUTH_URL=http://localhost:25001

# =============================================================================
# Web (Astro) — public; also set in web/.env
# =============================================================================
PUBLIC_CHAVEZ_API_URL=http://localhost:25001
PUBLIC_WEB_URL=http://localhost:25002
WEB_PORT=25002

# =============================================================================
# CLI / TUI — public
# =============================================================================
CHAVEZ_API_URL=http://localhost:25001
# CHAVEZ_CWD=

# =============================================================================
# CLI / TUI — private
# =============================================================================
# CHAVEZ_ACCESS_TOKEN=
# CHAVEZ_WS_DAEMON_LOG=
# CLAUDE_CONFIG_DIR=
