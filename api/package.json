{
  "name": "@chavez/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:push": "bunx drizzle-kit push",
    "test:e2e": "bun run scripts/e2e-phase1.ts",
    "auth:generate": "bunx @better-auth/cli@latest generate --config ./src/auth.ts --output ./src/db/auth-schema.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.270",
    "@better-auth/drizzle-adapter": "^1.4.0",
    "better-auth": "^1.4.0",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.13.7",
    "postgres": "^3.4.7",
    "resend": "^6.28.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.9.0"
  }
}
