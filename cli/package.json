{
  "name": "@chavez/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "chavez": "./src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "test:ignore": "bun run scripts/ignore-secrets-smoke.ts",
    "test:git-smoke": "bun run scripts/git-workspace-smoke.ts",
    "test:rules": "bun run scripts/rules-smoke.ts",
    "test:daemon-reconnect": "bun run scripts/daemon-reconnect-smoke.ts",
    "test:daemon-stale": "bun run scripts/daemon-stale-turn-smoke.ts",
    "test:daemon-presence": "bun run scripts/daemon-presence-smoke.ts",
    "test:daemon-first-wins": "bun run scripts/daemon-first-wins-smoke.ts",
    "test:tree": "bun run scripts/web-file-tree-smoke.ts",
    "test:thinking-smoke": "bun run scripts/thinking-steer-cancel-smoke.ts",
    "test:verify": "bun test src/llm/verify-*.test.ts && bun run scripts/verify-loop-smoke.ts",
    "test:mcp-smoke": "bun run scripts/mcp-skills-smoke.ts",
    "test:chat-org": "bun run scripts/chat-org-smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.270",
    "@cursor/sdk": "^1.0.31",
    "better-auth": "^1.4.0",
    "open": "^11.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
